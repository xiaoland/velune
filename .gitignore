# Operating system and editor metadata, anywhere in the tree.
.DS_Store
._*
*.swp
*~

# Workspace build outputs (Cargo workspace, SwiftPM package at the root).
/target/
/.build/
/.swiftpm/

# Local state and secrets.
/.pi/
/.ryugi/
*.sqlite*
.env
__pycache__/

# Android Gradle outputs.
/app/android/.gradle/
/app/android/build/
/app/android/app/build/
/app/android/local.properties
/app/android/.kotlin/

# Xcode per-user state.
/app/ios/**/xcuserdata/

