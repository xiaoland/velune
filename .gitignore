# Operating system and editor metadata, anywhere in the tree.
.DS_Store
._*
*.swp
*~

# Workspace build outputs (Cargo workspace, SwiftPM package at the root).
/target/
/.build/
/.swiftpm/

# Android local configuration and generated outputs.
/app/android/.gradle/
/app/android/.kotlin/
/app/android/**/build/
/app/android/local.properties
/app/android/**/*.jks
/app/android/**/*.keystore

# Local state and secrets.
*.sqlite*
.env
__pycache__/
