<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Velune.ConversationView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The tab shows the title; the outline's button is on the tab bar. -->
    <Grid x:Name="Body">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ListView
            x:Name="Transcript"
            Grid.Row="0"
            Padding="0,8,0,8"
            IsItemClickEnabled="False"
            SelectionMode="None">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel ItemsUpdatingScrollMode="KeepLastItemInView" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemContainerStyle>
                <!-- Messages are read, not chosen: no hover or selection. -->
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="IsTabStop" Value="False" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <ContentPresenter Padding="24,8,24,8" HorizontalContentAlignment="Stretch" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
        <ProgressRing x:Name="Spinner" Grid.Row="0" IsActive="False" />
        <!-- Clear of the scroll bar, which runs along the right edge. -->
        <Button
            x:Name="BottomButton"
            Grid.Row="0"
            Margin="0,0,28,12"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            AutomationProperties.Name="回到底部"
            ToolTipService.ToolTip="回到底部"
            Visibility="Collapsed">
            <FontIcon FontSize="14" Glyph="&#xE74B;" />
        </Button>
        <StackPanel
            Grid.Row="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12">
            <TextBlock
                x:Name="Empty"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <!-- A device without a runtime has nothing to start a conversation on. -->
            <Button
                x:Name="RuntimeButton"
                HorizontalAlignment="Center"
                Content="添加 Agent 运行时…"
                Style="{ThemeResource AccentButtonStyle}"
                Visibility="Collapsed" />
        </StackPanel>

        <Border
            x:Name="InteractionCard"
            Grid.Row="2"
            Margin="16,0,16,8"
            Padding="16"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Visibility="Collapsed" />

        <!-- Under the transcript, or in the composer's tool window. -->
        <Grid x:Name="ComposerArea" x:FieldModifier="internal" Grid.Row="3">
            <!-- A native sub-agent's conversation is read-only: the conversation that started it continues it. -->
            <Border
                x:Name="SubAgentBar"
                Padding="16,12,16,12"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Visibility="Collapsed">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="这是子 Agent 的会话，由启动它的会话继续。"
                        TextWrapping="Wrap" />
                    <Button x:Name="ParentButton" Grid.Column="1" Content="打开父会话" />
                </Grid>
            </Border>

            <Border
                x:Name="ComposerPanel"
                AllowDrop="True"
                Padding="16,12,16,12"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
                <StackPanel Spacing="8">
                    <!-- The send queue: messages sent while a turn runs, sent one by one after it. -->
                    <InfoBar
                        x:Name="QueueBar"
                        IsClosable="False"
                        Severity="Informational" />
                    <StackPanel x:Name="QueuePanel" Spacing="4" />
                    <ScrollViewer
                        x:Name="AttachmentScroller"
                        HorizontalScrollBarVisibility="Auto"
                        HorizontalScrollMode="Auto"
                        VerticalScrollBarVisibility="Disabled"
                        VerticalScrollMode="Disabled"
                        Visibility="Collapsed">
                        <StackPanel x:Name="AttachmentPanel" Orientation="Horizontal" Spacing="6" />
                    </ScrollViewer>
                    <TextBox
                        x:Name="Input"
                        MinHeight="64"
                        MaxHeight="240"
                        AcceptsReturn="True"
                        PlaceholderText="输入消息，Ctrl+Enter 发送"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        TextWrapping="Wrap" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button
                                x:Name="AttachButton"
                                AutomationProperties.Name="附加文件"
                                Padding="8,6,8,6"
                                ToolTipService.ToolTip="附加文件或图片；也可拖入或粘贴图片">
                                <FontIcon FontSize="14" Glyph="&#xE723;" />
                            </Button>
                            <DropDownButton x:Name="AgentButton" ToolTipService.ToolTip="下一轮的运行时、模型与推理强度">
                                <DropDownButton.Flyout>
                                    <MenuFlyout x:Name="AgentMenu" Placement="TopEdgeAlignedLeft" />
                                </DropDownButton.Flyout>
                            </DropDownButton>
                            <DropDownButton x:Name="PermissionButton">
                                <DropDownButton.Flyout>
                                    <MenuFlyout x:Name="PermissionMenu" Placement="TopEdgeAlignedLeft" />
                                </DropDownButton.Flyout>
                            </DropDownButton>
                            <DropDownButton x:Name="CwdButton">
                                <DropDownButton.Flyout>
                                    <MenuFlyout x:Name="CwdMenu" Placement="TopEdgeAlignedLeft" />
                                </DropDownButton.Flyout>
                            </DropDownButton>
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="4">
                            <!-- The status line: what the settings keep in sight; the button shows all. -->
                            <Button
                                x:Name="StatusButton"
                                Padding="8,4,8,4"
                                Background="Transparent"
                                BorderThickness="0">
                                <TextBlock
                                    x:Name="StatusText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}" />
                            </Button>
                            <Button
                                x:Name="ContinueButton"
                                Content="继续"
                                ToolTipService.ToolTip="让运行时接着做：作为一条用户消息发出，不重放此前的工具调用" />
                            <Button
                                x:Name="StopButton"
                                Content="停止"
                                ToolTipService.ToolTip="Esc" />
                            <Button
                                x:Name="SendButton"
                                Content="发送"
                                Style="{ThemeResource AccentButtonStyle}"
                                ToolTipService.ToolTip="Ctrl+Enter" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
