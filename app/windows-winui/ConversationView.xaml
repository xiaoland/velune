<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Velune.ConversationView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ListView
            x:Name="Transcript"
            Padding="0,8,0,8"
            IsItemClickEnabled="False"
            SelectionMode="None">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel ItemsUpdatingScrollMode="KeepLastItemInView" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemContainerStyle>
                <!-- Messages are read, not chosen: no hover or selection. -->
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="IsTabStop" Value="False" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <ContentPresenter Padding="24,8,24,8" HorizontalContentAlignment="Stretch" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
        <ProgressRing x:Name="Spinner" IsActive="False" />
        <TextBlock
            x:Name="Empty"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <InfoBar
            x:Name="FailureBar"
            Grid.Row="1"
            Margin="16,0,16,8"
            IsClosable="False"
            Severity="Error" />

        <Border
            x:Name="InteractionCard"
            Grid.Row="2"
            Margin="16,0,16,8"
            Padding="16"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Visibility="Collapsed" />

        <Border
            Grid.Row="3"
            Padding="16,12,16,12"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <StackPanel Spacing="8">
                <TextBox
                    x:Name="Input"
                    MinHeight="64"
                    MaxHeight="240"
                    AcceptsReturn="True"
                    PlaceholderText="输入消息，Ctrl+Enter 发送"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    TextWrapping="Wrap" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <DropDownButton x:Name="AgentButton" ToolTipService.ToolTip="下一轮的运行时、模型与推理强度">
                            <DropDownButton.Flyout>
                                <MenuFlyout x:Name="AgentMenu" Placement="TopEdgeAlignedLeft" />
                            </DropDownButton.Flyout>
                        </DropDownButton>
                        <DropDownButton x:Name="PermissionButton">
                            <DropDownButton.Flyout>
                                <MenuFlyout x:Name="PermissionMenu" Placement="TopEdgeAlignedLeft" />
                            </DropDownButton.Flyout>
                        </DropDownButton>
                        <DropDownButton x:Name="CwdButton">
                            <DropDownButton.Flyout>
                                <MenuFlyout x:Name="CwdMenu" Placement="TopEdgeAlignedLeft" />
                            </DropDownButton.Flyout>
                        </DropDownButton>
                        <StackPanel
                            x:Name="RunningState"
                            Margin="8,0,0,0"
                            Orientation="Horizontal"
                            Spacing="8">
                            <ProgressRing Width="16" Height="16" IsActive="True" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="正在运行" />
                        </StackPanel>
                    </StackPanel>
                    <Button
                        x:Name="SendButton"
                        Grid.Column="1"
                        Content="发送"
                        Style="{ThemeResource AccentButtonStyle}"
                        ToolTipService.ToolTip="Ctrl+Enter" />
                    <Button
                        x:Name="StopButton"
                        Grid.Column="1"
                        Content="停止" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
